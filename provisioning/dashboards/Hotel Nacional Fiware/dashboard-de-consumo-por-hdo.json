      "targets": [
        {
          "csvContent": "Tipo,Valor\nReal,4.3\nPlan,2.4\nReal AA,2",
          "datasource": "grafana-postgresql-datasource",
          "dropPercent": 0,
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_data AS (\n    SELECT\n        unit,\n        year_plan, year_real, year_real_last_year,\n        month_plan, month_real, month_real_last_year,\n        day_plan, day_real, day_real_last_year,\n        date_observed\n    FROM consumption_data\n    WHERE carrier_type = '$carrier_type'\n      AND date_observed BETWEEN to_timestamp($__from / 1000)::date \n                            AND to_timestamp($__to / 1000)::date\n    ORDER BY date_observed DESC\n    LIMIT 1\n),\ncalculated_values AS (\n    SELECT\n        unit,\n        to_char(date_observed, 'DD/MM/YYYY') AS formated_date,\n        \n        -- Anual\n        year_plan AS plan_year, \n        year_real AS real_year, \n        year_real_last_year AS real_aa_year,\n        CASE WHEN year_real > 0 THEN ROUND(((year_real_last_year - year_real)::numeric / year_real) * 100, 1) ELSE 0 END AS percent_aa_year,\n        CASE WHEN year_real > 0 THEN ROUND(((year_plan - year_real)::numeric / year_real) * 100, 1) ELSE 0 END AS percent_plan_year,\n        \n        -- Mensual\n        month_plan AS plan_month, \n        month_real AS real_month, \n        month_real_last_year AS real_aa_month,\n        CASE WHEN month_real > 0 THEN ROUND(((month_real_last_year - month_real)::numeric / month_real) * 100, 1) ELSE 0 END AS percent_aa_month,\n        CASE WHEN month_real > 0 THEN ROUND(((month_plan - month_real)::numeric / month_real) * 100, 1) ELSE 0 END AS percent_plan_month,\n        \n        -- Diario\n        day_plan AS plan_day, \n        day_real AS real_day, \n        day_real_last_year AS real_aa_day,\n        CASE WHEN day_real > 0 THEN ROUND(((day_real_last_year - day_real)::numeric / day_real) * 100, 1) ELSE 0 END AS percent_aa_day,\n        CASE WHEN day_real > 0 THEN ROUND(((day_plan - day_real)::numeric / day_real) * 100, 1) ELSE 0 END AS percent_plan_day\n    FROM latest_data\n)\nSELECT\n    'Anual ' AS categoria,\n    CASE WHEN percent_aa_year > 0 THEN '+' || percent_aa_year::text || '% ▲' WHEN percent_aa_year < 0 THEN percent_aa_year::text || '% ▼' ELSE '0.0%' END AS \"Porcentaje AA\",\n    real_aa_year AS \"Real AA\",\n    CASE WHEN percent_plan_year > 0 THEN '+' || percent_plan_year::text || '% ▲' WHEN percent_plan_year < 0 THEN percent_plan_year::text || '% ▼' ELSE '0.0%' END AS \"Porcentaje Plan\",\n    plan_year AS \"Plan\",\n    real_year AS \"Real\",\n    formated_date\nFROM calculated_values\n\nUNION ALL\n\nSELECT\n    'Mensual ' AS categoria,\n    CASE WHEN percent_aa_month > 0 THEN '+' || percent_aa_month::text || '% ▲' WHEN percent_aa_month < 0 THEN percent_aa_month::text || '% ▼' ELSE '0.0%' END AS \"Porcentaje AA\",\n    real_aa_month AS \"Real AA\",\n    CASE WHEN percent_plan_month > 0 THEN '+' || percent_plan_month::text || '% ▲' WHEN percent_plan_month < 0 THEN percent_plan_month::text || '% ▼' ELSE '0.0%' END AS \"Porcentaje Plan\",\n    plan_month AS \"Plan\",\n    real_month AS \"Real\",\n    formated_date\nFROM calculated_values\n\nUNION ALL\n\nSELECT\n    'Diario ' AS categoria,\n    CASE WHEN percent_aa_day > 0 THEN '+' || percent_aa_day::text || '% ▲' WHEN percent_aa_day < 0 THEN percent_aa_day::text || '% ▼' ELSE '0.0%' END AS \"Porcentaje AA\",\n    real_aa_day AS \"Real AA\",\n    CASE WHEN percent_plan_day > 0 THEN '+' || percent_plan_day::text || '% ▲' WHEN percent_plan_day < 0 THEN percent_plan_day::text || '% ▼' ELSE '0.0%' END AS \"Porcentaje Plan\",\n    plan_day AS \"Plan\",\n    real_day AS \"Real\",\n    formated_date\nFROM calculated_values;",
          "refId": "A",
          "scenarioId": "csv_content",
          "sql": {
